# ═══════════════════════════════════════════════════════════
#  FYONA ERP — Environment Configuration
# ═══════════════════════════════════════════════════════════
#
# هذه القيم مخصصة لـ Docker Compose.
# أسماء الخدمات (db, redis, minio) تستخدم داخل Docker network.
#
# إذا كنت تشغل الخدمات محلياً بدون Docker:
#   db → localhost
#   redis → localhost
#   minio → localhost
# ═══════════════════════════════════════════════════════════

# Application
APP_NAME=FYONA ERP API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
# Public URL of this API. Local: http://127.0.0.1:8001 | Prod: https://api.jeetak-lounge.com
API_BASE_URL=http://127.0.0.1:8001

# Security — غيّر هذا في الإنتاج
JWT_SECRET_KEY=

# Database (داخل Docker: db, محلياً: localhost)
DATABASE_URL=postgresql+asyncpg://fyona:fyona@db:5432/fyona_erp

# Redis (داخل Docker: redis, محلياً: localhost)
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fyona-files

# Background Tasks
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Rate Limiting — اختياري (له قيم افتراضية)
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_IP_MINUTE=20

# CORS — قائمة المواقع المسموح بها (JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://app.jeetak-lounge.com", "https://api.jeetak-lounge.com"]  # ← غيّرها للـ domains الفعلية للواجهة

# Allowed Hosts — قائمة النطاقات المسموح بها (JSON array)
ALLOWED_HOSTS=["localhost", "127.0.0.1", "api.jeetak-lounge.com"]  # ← غيّرها للـ domain الفعلي للـ Backend

# Firebase Admin — التحقق من Firebase ID Tokens
# المسار داخل الحاوية (يُركّب من serviceAccount.json في docker-compose)
FIREBASE_PROJECT_ID=fyonaerp
FIREBASE_CREDENTIALS_PATH=/app/serviceAccount.json

# AI — اختياري
OPENAI_API_KEY=

# Exchange Rates — اختياري
EXCHANGE_RATE_HOST_KEY=

# EgCurrency — أسعار الصرف من egcurrency.com
EGCURRENCY_API_KEY=

# SMS — مفتاح بوابة الرسائل النصية (اختياري، يُقرأ من هنا فقط)
SMS_API_KEY=

# Maps — مفتاح الخرائط (اختياري، يُقرأ من هنا فقط)
MAP_API_KEY=

# Sentry — اختياري، لتعقب الأخطاء
SENTRY_DSN=

# SMTP / Email — مطلوب لتفعيل OTP والإشعارات البريدية
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fyona ERP <your-company@gmail.com>"
SMTP_TLS=true

# OTP — التحقق من الرموز
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
PENDING_REGISTRATION_TTL_MINUTES=15

# Logging
LOG_LEVEL=INFO

# ── Stripe / Payments ──
# جميع مفاتيح Stripe تُقرأ من هذا الملف فقط ولا تُدار من لوحة الأدمن.
# (لا تضع مفاتيح حقيقية في ملف يصل للـ repo)
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_CURRENCY=SAR
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Deployment (set by CI/CD, do not edit manually) ──
DEPLOY_SHA=
GHCR_ORG=fyona-erp
