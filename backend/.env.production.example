# FYONA ERP — Production Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env.production on the VPS and fill in real values.
# NEVER commit .env.production to version control.
#
# Usage: DEPLOY_SHA=abc123456789 GHCR_ORG=fyona-erp docker compose \
#        -f docker-compose.yml -f docker-compose.prod.yml \
#        --env-file .env.production up -d

# ── Application ──
APP_NAME=FYONA ERP API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_BASE_URL=https://api.dssdfs.fun

# ── Security ──
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# PRODUCTION KEY — different from development key
JWT_SECRET_KEY=

# ── Database ──
# Production database credentials — different from development
POSTGRES_USER=fyona
POSTGRES_PASSWORD=          # ← Strong password for production
POSTGRES_DB=fyona_erp
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Storage (MinIO) ──
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=              # ← Production MinIO user
S3_SECRET_KEY=              # ← Production MinIO password
S3_BUCKET=fyona-files
MINIO_ROOT_USER=            # ← Generate a strong username for production
MINIO_ROOT_PASSWORD=        # ← Generate a strong password for production

# ── Background Tasks ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS ──
# Include your app domain and API domain
CORS_ORIGINS=["https://app.dssdfs.fun", "https://api.dssdfs.fun"]

# ── Allowed Hosts ──
ALLOWED_HOSTS=["localhost", "127.0.0.1", "api.dssdfs.fun"]

# ── Firebase Admin ──
FIREBASE_PROJECT_ID=fyonaerp
FIREBASE_CREDENTIALS_PATH=/app/serviceAccount.json

# ── AI ──
OPENAI_API_KEY=

# ── Exchange Rates ──
EXCHANGE_RATE_HOST_KEY=
EGCURRENCY_API_KEY=

# ── SMS / Maps ──
SMS_API_KEY=
MAP_API_KEY=

# ── Sentry ──
SENTRY_DSN=

# ── SMTP / Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fyona ERP <noreply@dssdfs.fun>"
SMTP_TLS=true

# ── OTP ──
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
PENDING_REGISTRATION_TTL_MINUTES=15

# ── Logging ──
LOG_LEVEL=WARNING

# ── Stripe / Payments ──
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_CURRENCY=SAR
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Deployment (set by CI/CD, do not edit manually) ──
DEPLOY_SHA=          # Set by CI/CD pipeline
GHCR_ORG=fyona-erp  # GitHub org for GHCR image pulls
