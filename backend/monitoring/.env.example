# ── FYONA ERP Monitoring Stack Environment ──
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ══════════════════════════════════════════════════════════════
#  Grafana Admin
# ══════════════════════════════════════════════════════════════
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ══════════════════════════════════════════════════════════════
#  PostgreSQL (for postgres_exporter)
# ══════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=fyona

# ══════════════════════════════════════════════════════════════
#  SMTP (for email alerts) — set GF_SMTP_ENABLED=true to enable
# ══════════════════════════════════════════════════════════════
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=alerts@example.com
GF_SMTP_PASSWORD=your_smtp_password
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# ══════════════════════════════════════════════════════════════
#  Email Alerts (recipient address)
# ══════════════════════════════════════════════════════════════
GF_ALERT_EMAIL=admin@fyona.com

# ══════════════════════════════════════════════════════════════
#  Telegram Bot (for instant alerts)
# ══════════════════════════════════════════════════════════════
# Get bot token from @BotFather on Telegram
GF_TELEGRAM_BOT_TOKEN=
# Get chat ID by messaging @userinfobot or @getmyid_bot
GF_TELEGRAM_CHAT_ID=
