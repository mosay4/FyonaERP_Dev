{
	admin off
	auto_https disable_redirects
	default_bind {$FYONA_QA_TLS_BIND:127.0.0.1}
	servers {
		protocols h1 h2
	}
}

https://qa.fyonacompany.com:18443 {
	tls {$FYONA_QA_CERT} {$FYONA_QA_KEY} {
		protocols tls1.2 tls1.3
	}
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	@blocked path /metrics /docs /docs/* /redoc /redoc/* /openapi.json /fyona-admin /fyona-admin/* /api/v1/admin /api/v1/admin/* /api/v1/payments /api/v1/payments/*
	respond @blocked 404
	@health path /version /health /api/v1/health/ready
	handle @health {
		reverse_proxy {$FYONA_QA_UPSTREAM:127.0.0.1:18084}
	}
	@app path /api/v1 /api/v1/* /uploads/*
	handle @app {
		request_body {
			max_size 10MB
		}
		reverse_proxy {$FYONA_QA_UPSTREAM:127.0.0.1:18084} {
			transport http {
				dial_timeout 4s
				response_header_timeout 25s
			}
		}
	}
	handle {
		respond 404
	}
}
